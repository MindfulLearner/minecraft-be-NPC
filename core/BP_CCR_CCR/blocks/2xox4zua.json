            },
            "pan_side": {
              "texture": "cc:pan_side",
              "render_method": "alpha_test"
            },
            "pan_top": {
              "texture": "cc:pan_top",
              "render_method": "alpha_test"
            },
            "pan_bottom": {
              "texture": "cc:pan_bottom",
