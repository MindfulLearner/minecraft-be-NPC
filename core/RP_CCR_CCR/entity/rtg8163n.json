{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "cc:ice_bow_projectile",
      "materials": {
        "default": "arrow"
      },
      "textures": {
        "default": "textures/entity/arrows"
      },
      "particle_effects": {
        "particle": "minecraft:basic_crit_particle"
      },
      "geometry": {
        "default": "geometry.arrow"
      },
      "animations": {
        "move": "animation.arrow.move",
        "particle": "animation.cc.particle"
      },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ],
        "animate": [
          "move",
          {"particle": "q.property('cc:particle') && math.abs(q.vertical_speed) > 0.05"}
        ]
      },
      "render_controllers": [
        "controller.render.arrow"
      ]
    }
  }
}