{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "cc:netherite_javelin",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/cc/weapons/items/javelin/netherite",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.cc.mesh_attachable"
      },
      "animations": {
        "wield_first_person": "animation.cc.weapon.wield.first_person",
        "wield_first_person_as": "animation.cc.weapon.wield.first_person.as",
        "wield_third_person": "animation.cc.weapon.wield.third_person",
        "first_person_attack": "animation.cc.player.attack.attachable",
        "first_person_attack_controller": "controller.animation.cc.attack.first_person",
        "wield_first_person_raise": "animation.cc.trident.wield_first_person_raise",
        "wield_first_person_raise_shake": "animation.cc.trident.wield_first_person_raise_shake",
        "wield_first_person_riptide": "animation.cc.trident.wield_first_person_riptide",
        "wield_third_person_raise": "animation.cc.trident.wield_third_person_raise",
        "scale": "animation.cc.weapon.scale.20px"
      },
      "scripts": {
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1;}; c.item_slot == 'off_hand' ? {v.oreville_offhand_visible = 1; }; v.oreville_mainhand_custom_pos = 1;",
        "pre_animation": [
          "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / 10.0, 0.0, 1.0f);",
          "v.actions_and_stuff = c.owning_entity -> v.actions_and_stuff;",
          "v.attack_time = c.owning_entity -> v.attack_time;"
        ],
        "animate": [
          { "wield_first_person": "c.is_first_person && !v.actions_and_stuff" },
          { "wield_first_person_as": "c.is_first_person && v.actions_and_stuff" },
          { "first_person_attack_controller": "c.is_first_person && !v.actions_and_stuff" },
          {
            "wield_first_person_raise": "c.is_first_person && !v.actions_and_stuff && query.main_hand_item_use_duration > 0.0f"
          },
          {
            "wield_first_person_raise_shake": "c.is_first_person && query.main_hand_item_use_duration > 0.0f"
          },
          {
            "wield_first_person_riptide": "c.is_first_person && query.can_damage_nearby_mobs > 0.0"
          },
          { "wield_third_person": "!c.is_first_person" },
          {
            "wield_third_person_raise": "!c.is_first_person && !v.actions_and_stuff && (query.main_hand_item_use_duration > 0.0f || query.has_target)"
          },

          "scale"
        ]
      },
      "render_controllers": ["controller.render.item_default"]
    }
  }
}
