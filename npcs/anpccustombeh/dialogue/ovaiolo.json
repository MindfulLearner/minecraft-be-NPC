                "scene_tag": "ovaiolo_main",
                "npc_name": "§aZio Beppe",
                "text": "§0Le mie creature sono le migliori!\nOgni uovo è una vita nuova.\nTratta bene i miei animali.\n§cSe hai una farm di uova automatica... dio porco.\n\n§e§lACQUISTA §0(tu dai gemme)\n§0Lupo/Wolf §c-13\n§0Cavallo/Horse §c-17\n§0Asino/Donkey §c-12\n§0Coniglio/Rabbit §c-7\n§0Ape/Bee §c-11\n§0Axolotl §c-15\n§0Panda §c-22\n§0Volpe/Fox §c-13\n§0Ocelot §c-9\n§0Gatto/Cat §c-9\n§0Pappagallo/Parrot §c-10\n§0Rana/Frog §c-8\n§0Capra/Goat §c-10\n§0Lama/Llama §c-14\n§0Tartaruga/Turtle §c-12\n§0Orso Pol./Polar Bear §c-12\n§0Cammello/Camel §c-20\n§0Armadillo §c-11\n§0Strider §c-10\n§0Fungosso/Mooshroom §c-18\n§0Hoglin §c-12\n§0Enderman §c-14\n§0Phantom §c-16\n§0Sniffer §c-24\n\n§a§lVENDI §0(l'NPC ti paga)\n§0Uova/Egg x32 §a+1\n§0Piume/Feather x16 §a+1\n§0Lana/Wool x32 §a+1",
                "on_open_commands": [
                    "/say [Zio Beppe] §e@initiator §fsi avvicina. Attento, le uova mordono!",
                    "/execute as @initiator run scriptevent ovaiolo:balance"
                ],
                "buttons": [
                    { "name": "§e» Compra", "commands": ["/dialogue open @e[tag=ovaiolo,r=2] @initiator ovaiolo_buy"] },
                    { "name": "§a» Vendi",  "commands": ["/dialogue open @e[tag=ovaiolo,r=2] @initiator ovaiolo_sell"] },
                    { "name": "§a» Tutto",  "commands": ["/scriptevent ovaiolo:sellall"] }
