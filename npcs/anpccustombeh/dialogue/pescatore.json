{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "pescatore_intro",
                "npc_name": "§bOld Piero",
                "text": "§3...\n§bGo away. Water takes everything.\n§3I don't want help from anyone.",
                "on_open_commands": ["/execute as @initiator run scriptevent pescatore:balance"],
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent pescatore:missioni"] },
                    { "name": "§b» Advanced", "commands": ["/scriptevent pescatore:hub_accesso"] },
                    { "name": "§0» Story",    "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_storia"] }
                ]
            },
            {
                "scene_tag": "pescatore_storia",
                "npc_name": "§bOld Piero",
                "text": "§bWe were on the boat. Me, Anna, the kids.\n§3Something enormous rose from the deep.\n§bI couldn't do anything. Nothing.",
                "buttons": [
                    { "name": "§eRevenge", "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_patto"] },
                    { "name": "§eSorry",   "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_patto"] }
                ]
            },
            {
                "scene_tag": "pescatore_patto",
                "npc_name": "§bOld Piero",
                "text": "§bReally? I can't touch a rod anymore.\n§3But you can. Fish for me.\n§bEvery fish is a step toward revenge.",
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_main"] }
                ]
            },
            {
                "scene_tag": "pescatore_main",
                "npc_name": "§bOld Piero",
                "text": "§bI'm scared. But you're not.\n§3Fish for me. I'll pay in gems.\n\n§0Cod §7▸ 20 Cod §a+1\n§0Salmon §7▸ 20 Salmon §a+1\n§0Tropical §7▸ 15 Tropical Fish §a+1",
                "buttons": [
                    { "name": "§eCod",   "commands": ["/scriptevent pescatore:accept piero_pesce"] },
                    { "name": "§eSalmon",   "commands": ["/scriptevent pescatore:accept piero_salmone"] },
                    { "name": "§eTropical", "commands": ["/scriptevent pescatore:accept piero_tropicale"] },
                    { "name": "§3« Back",   "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_intro"] }
                ]
            },
            {
                "scene_tag": "pescatore_consegna",
                "npc_name": "§bOld Piero",
                "text": "§bDid you bring the fish?\n§3Every fish is... justice.\n\n§0Cod §7▸ 20 Cod\n§0Salmon §7▸ 20 Salmon\n§0Tropical §7▸ 15 Tropical Fish",
                "buttons": [
                    { "name": "§eCod",   "commands": ["/scriptevent pescatore:deliver piero_pesce"] },
                    { "name": "§eSalmon",   "commands": ["/scriptevent pescatore:deliver piero_salmone"] },
                    { "name": "§eTropical", "commands": ["/scriptevent pescatore:deliver piero_tropicale"] },
                    { "name": "§3« Back",   "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_main"] }
                ]
            },
            {
                "scene_tag": "pescatore_hub",
                "npc_name": "§bOld Piero",
                "text": "§bYou came back.\n§3Real challenges or deliver?",
                "buttons": [
                    { "name": "§b» Challenges", "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_sfide"] },
                    { "name": "§a» Deliver",    "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_consegna_av"] }
                ]
            },
            {
                "scene_tag": "pescatore_sfide",
                "npc_name": "§bOld Piero",
                "text": "§bThese aren't for everyone.\n§3Choose your challenge.\n\n§0Prismarine §7▸ Prism. x64 + Crystals x16 + Ink x16 §a+1\n§0Guardians §7▸ 12 Guardians killed §a+1\n§0Trident §7▸ Trident x1 + Nautilus x8 §a+1\n§cElder §7▸ 1 Elder Guardian §a+1",
                "buttons": [
                    { "name": "§ePrismarine", "commands": ["/scriptevent pescatore:accept piero_prismarina"] },
                    { "name": "§eGuardians",  "commands": ["/scriptevent pescatore:accept piero_guardiani"] },
                    { "name": "§eTrident",    "commands": ["/scriptevent pescatore:accept piero_tridente"] },
                    { "name": "§cElder",      "commands": ["/scriptevent pescatore:accept piero_elder"] },
                    { "name": "§3« Back",     "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_hub"] }
                ]
            },
            {
                "scene_tag": "pescatore_consegna_av",
                "npc_name": "§bOld Piero",
                "text": "§bDid you complete something?\n§3Tell me.\n\n§0Cod §7▸ 20 Cod\n§0Prismarine §7▸ Prism. x64 + Crystals x16 + Ink x16\n§0Guardians §7▸ 12 Guardians\n§0Trident §7▸ Trident x1 + Nautilus x8\n§cElder §7▸ 1 Elder Guardian",
                "buttons": [
                    { "name": "§eCod",    "commands": ["/scriptevent pescatore:deliver piero_pesce"] },
                    { "name": "§ePrismarine","commands": ["/scriptevent pescatore:deliver piero_prismarina"] },
                    { "name": "§eGuardians", "commands": ["/scriptevent pescatore:deliver piero_guardiani"] },
                    { "name": "§eTrident",   "commands": ["/scriptevent pescatore:deliver piero_tridente"] },
                    { "name": "§cElder",     "commands": ["/scriptevent pescatore:deliver piero_elder"] },
                    { "name": "§3« Back",    "commands": ["/dialogue open @e[tag=pescatore,r=2] @initiator pescatore_hub"] }
                ]
            }
        ]
    }
}
