                    { "name": "§eSouls",      "commands": ["/scriptevent cultista:accept niss_anime"] },
                    { "name": "§ePiglin",      "commands": ["/scriptevent cultista:accept niss_piglin"] },
                    { "name": "§eSacrifice",   "commands": ["/scriptevent cultista:accept niss_sacrificio"] },
                    { "name": "§cWither",      "commands": ["/scriptevent cultista:accept niss_wither"] },
                    { "name": "§0« Back",      "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_hub_en"] }
                ]
            },
            {
                "scene_tag": "cultista_giornaliere_en",
                "npc_name": "§5Cultist",
                "text": "§fEvery day the cult demands tribute.\n§7▸ 8 Rotten Flesh §a→ +1 gem",
                "buttons": [
                    { "name": "§e↺ Accept", "commands": ["/scriptevent cultista:accept cultista_giorn"] },
                    { "name": "§0« Back",   "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_intro_en"] }
                ]
