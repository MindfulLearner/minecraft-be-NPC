{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "cultista_intro",
                "npc_name": "§5Cultista",
                "text": "§fUn'altra anima si avvicina...\n§7Chi sei, straniero?",
                "on_open_commands": ["/execute as @initiator run scriptevent cultista:lang_check"],
                "buttons": [
                    { "name": "§e» Missioni",    "commands": ["/scriptevent cultista:missioni"] },
                    { "name": "§e» Giornaliere", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_giornaliere"] },
                    { "name": "§5» Riti Av.",    "commands": ["/scriptevent cultista:riti_accesso"] }
                ]
            },
            {
                "scene_tag": "cultista_avventuriero",
                "npc_name": "§5Cultista",
                "text": "§fUn avventuriero...\n§7Josh ne manda uno ogni settimana.\n§fBene. Ho lavoro per te.",
                "buttons": [
                    { "name": "§e» Missioni", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_main"] }
                ]
            },
            {
                "scene_tag": "cultista_main",
                "npc_name": "§5Cultista",
                "text": "§fScegli la tua missione.\n\n§0Legna §7▸ 32 Tronchi §a+4\n§0Ossa §7▸ 10 Scheletri §a+6\n§0Sfama §7▸ 16 Pane §a+5\n§0Buio §7▸ Scendi Y≤30 §a+5\n§0Creeper §7▸ 5 Creeper §a+4",
                "buttons": [
                    { "name": "§eLegna",       "commands": ["/scriptevent cultista:accept taglialegna"] },
                    { "name": "§eOssa",         "commands": ["/scriptevent cultista:accept ossa"] },
                    { "name": "§eSfama",        "commands": ["/scriptevent cultista:accept sfama"] },
                    { "name": "§eBuio",         "commands": ["/scriptevent cultista:accept buio"] },
                    { "name": "§eCreeper",      "commands": ["/scriptevent cultista:accept creeper"] }
                ]
            },
            {
                "scene_tag": "cultista_ritorno",
                "npc_name": "§5Cultista",
                "text": "§fIl culto conosce ogni angolo del mondo.\n§8Posso riportarti dove hai perso la vita.",
                "buttons": [
                    { "name": "§aVai!",       "commands": ["/scriptevent cultista:ritorno_morte"] },
                    { "name": "§0« Indietro", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_intro"] }
                ]
            },
            {
                "scene_tag": "cultista_consegna",
                "npc_name": "§5Cultista",
                "text": "§fIl culto osserva.\n§7Quale missione hai completato?\n\n§0Legna §7▸ 32 Tronchi\n§0Ossa §7▸ 10 Scheletri uccisi\n§0Sfama §7▸ 16 Pane\n§0Buio §7▸ Visita Y≤30\n§0Creeper §7▸ 5 Creeper uccisi",
                "buttons": [
                    { "name": "§eLegna",       "commands": ["/scriptevent cultista:deliver taglialegna"] },
                    { "name": "§eOssa",         "commands": ["/scriptevent cultista:deliver ossa"] },
                    { "name": "§eSfama",        "commands": ["/scriptevent cultista:deliver sfama"] },
                    { "name": "§eBuio",         "commands": ["/scriptevent cultista:deliver buio"] },
                    { "name": "§eCreeper",      "commands": ["/scriptevent cultista:deliver creeper"] },
                    { "name": "§0« Indietro",  "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_main"] }
                ]
            },
            {
                "scene_tag": "cultista_hub",
                "npc_name": "§5Cultista",
                "text": "§fLe prove sono complete.\n§8Ora iniziano i veri riti del Culto.",
