{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "cultista_intro",
                "npc_name": "§5Cultist",
                "text": "§fAnother soul approaches...\n§7Who are you, stranger?",
                "on_open_commands": ["/execute as @initiator run scriptevent cultista:balance"],
                "buttons": [
                    { "name": "§e» Missions",       "commands": ["/scriptevent cultista:missioni"] },
                    { "name": "§5» Advanced Rites",  "commands": ["/scriptevent cultista:riti_accesso"] }
                ]
            },
            {
                "scene_tag": "cultista_avventuriero",
                "npc_name": "§5Cultist",
                "text": "§fAn adventurer...\n§7Josh sends one every week.\n§fGood. I have work for you.",
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_main"] }
                ]
            },
            {
                "scene_tag": "cultista_main",
                "npc_name": "§5Cultist",
                "text": "§fChoose your mission.\n\n§0Wood §7▸ 64 Logs §a+1\n§0Bones §7▸ 25 Skeletons §a+1\n§0Feed §7▸ 32 Bread §a+1\n§0Dark §7▸ Descend Y≤30 §a+1\n§0Creeper §7▸ 15 Creepers §a+1",
                "buttons": [
                    { "name": "§eWood",    "commands": ["/scriptevent cultista:accept taglialegna"] },
                    { "name": "§eBones",   "commands": ["/scriptevent cultista:accept ossa"] },
                    { "name": "§eFeed",    "commands": ["/scriptevent cultista:accept sfama"] },
                    { "name": "§eDark",    "commands": ["/scriptevent cultista:accept buio"] },
                    { "name": "§eCreeper", "commands": ["/scriptevent cultista:accept creeper"] }
                ]
            },
            {
                "scene_tag": "cultista_ritorno",
                "npc_name": "§5Cultist",
                "text": "§fThe Cult knows every corner of the world.\n§8I can take you back to where you died.",
                "buttons": [
                    { "name": "§aGo!",        "commands": ["/scriptevent cultista:ritorno_morte"] },
                    { "name": "§0« Back",     "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_intro"] }
                ]
            },
            {
                "scene_tag": "cultista_consegna",
                "npc_name": "§5Cultist",
                "text": "§fThe Cult is watching.\n§7Which mission did you complete?\n\n§0Wood §7▸ 64 Logs\n§0Bones §7▸ 25 Skeletons killed\n§0Feed §7▸ 32 Bread\n§0Dark §7▸ Reach Y≤30\n§0Creeper §7▸ 15 Creepers killed",
                "buttons": [
                    { "name": "§eWood",       "commands": ["/scriptevent cultista:deliver taglialegna"] },
                    { "name": "§eBones",      "commands": ["/scriptevent cultista:deliver ossa"] },
                    { "name": "§eFeed",       "commands": ["/scriptevent cultista:deliver sfama"] },
                    { "name": "§eDark",       "commands": ["/scriptevent cultista:deliver buio"] },
                    { "name": "§eCreeper",    "commands": ["/scriptevent cultista:deliver creeper"] },
                    { "name": "§0« Back",     "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_main"] }
                ]
            },
            {
                "scene_tag": "cultista_hub",
                "npc_name": "§5Cultist",
                "text": "§fThe trials are complete.\n§8Now the true Cult rites begin.",
                "buttons": [
                    { "name": "§5» Rites",    "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_riti"] },
                    { "name": "§a» Deliver",  "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_consegna_av"] }
                ]
            },
            {
                "scene_tag": "cultista_riti",
                "npc_name": "§5Cultist",
                "text": "§fThe Cult demands sacrifices.\n\n§5Souls §7▸ Soul Sand x64 + Soul Soil x32 §a+1\n§5Piglin §7▸ 15 Piglin Brutes §a+1\n§5Sacrifice §7▸ Totem x2 + Ghast Tears x8 §a+1\n§cWither §7▸ Kill 1 Wither §a+1",
                "buttons": [
                    { "name": "§eSouls",     "commands": ["/scriptevent cultista:accept niss_anime"] },
                    { "name": "§ePiglin",    "commands": ["/scriptevent cultista:accept niss_piglin"] },
                    { "name": "§eSacrifice", "commands": ["/scriptevent cultista:accept niss_sacrificio"] },
                    { "name": "§cWither",    "commands": ["/scriptevent cultista:accept niss_wither"] },
                    { "name": "§0« Back",   "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_hub"] }
                ]
            },
            {
                "scene_tag": "cultista_consegna_av",
                "npc_name": "§5Cultist",
                "text": "§fThe Cult is watching.\n§7Which rite have you completed?\n\n§5Souls §7▸ Soul Sand x64 + Soul Soil x32\n§5Piglin §7▸ 15 Piglin Brutes\n§5Sacrifice §7▸ Totem x2 + Ghast Tears x8\n§cWither §7▸ 1 Wither killed",
                "buttons": [
                    { "name": "§eSouls",     "commands": ["/scriptevent cultista:deliver niss_anime"] },
                    { "name": "§ePiglin",    "commands": ["/scriptevent cultista:deliver niss_piglin"] },
                    { "name": "§eSacrifice", "commands": ["/scriptevent cultista:deliver niss_sacrificio"] },
                    { "name": "§cWither",    "commands": ["/scriptevent cultista:deliver niss_wither"] },
                    { "name": "§0« Back",   "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_hub"] }
                ]
            }        ]
    }
}
