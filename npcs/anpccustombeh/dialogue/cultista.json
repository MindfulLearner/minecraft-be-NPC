                    { "name": "§5» Riti",     "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_riti"] },
                    { "name": "§a» Consegna", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_consegna_av"] }
                ]
            },
            {
                "scene_tag": "cultista_riti",
                "npc_name": "§5Cultista",
                "text": "§fIl Culto chiede sacrifici.\n\n§5Anime §7▸ Sabbia Anime x32 + Terreno x16 §a+16\n§5Piglin §7▸ 8 Piglin Brute §a+24\n§5Sacrificio §7▸ Totem x1 + Lacrime Ghast x4 §a+28\n§cWither §7▸ Uccidi 1 Wither §a+45",
                "buttons": [
                    { "name": "§eAnime",       "commands": ["/scriptevent cultista:accept niss_anime"] },
                    { "name": "§ePiglin",       "commands": ["/scriptevent cultista:accept niss_piglin"] },
                    { "name": "§eSacrificio",   "commands": ["/scriptevent cultista:accept niss_sacrificio"] },
                    { "name": "§cWither",       "commands": ["/scriptevent cultista:accept niss_wither"] },
                    { "name": "§0« Indietro",  "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_hub"] }
                ]
            },
            {
                "scene_tag": "cultista_consegna_av",
                "npc_name": "§5Cultista",
                "text": "§fIl Culto osserva.\n§7Quale rito hai completato?\n\n§5Anime §7▸ Sabbia Anime x32 + Terreno x16\n§5Piglin §7▸ 8 Piglin Brute\n§5Sacrificio §7▸ Totem x1 + Lacrime Ghast x4\n§cWither §7▸ 1 Wither ucciso",
                "buttons": [
                    { "name": "§eAnime",       "commands": ["/scriptevent cultista:deliver niss_anime"] },
                    { "name": "§ePiglin",       "commands": ["/scriptevent cultista:deliver niss_piglin"] },
                    { "name": "§eSacrificio",   "commands": ["/scriptevent cultista:deliver niss_sacrificio"] },
                    { "name": "§cWither",       "commands": ["/scriptevent cultista:deliver niss_wither"] },
                    { "name": "§0« Indietro",  "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_hub"] }
                ]
            },
            {
                "scene_tag": "cultista_giornaliere",
                "npc_name": "§5Cultista",
                "text": "§fOgni giorno il culto richiede un tributo.\n§7▸ 8 Carne Marcia §a→ +1 gemma",
                "buttons": [
                    { "name": "§e↺ Accetta",  "commands": ["/scriptevent cultista:accept cultista_giorn"] },
                    { "name": "§0« Indietro", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_intro"] }
                ]
            },
            {
                "scene_tag": "cultista_intro_en",
                "npc_name": "§5Cultist",
                "text": "§fAnother soul approaches...\n§7Who are you, stranger?",
                "buttons": [
                    { "name": "§e» Missions",       "commands": ["/scriptevent cultista:missioni"] },
                    { "name": "§e» Daily",           "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_giornaliere_en"] },
                    { "name": "§5» Advanced Rites",  "commands": ["/scriptevent cultista:riti_accesso"] }
                ]
            },
            {
                "scene_tag": "cultista_main_en",
                "npc_name": "§5Cultist",
                "text": "§fChoose your mission.\n\n§0Wood §7▸ 32 Logs §a+4\n§0Bones §7▸ 10 Skeletons §a+6\n§0Feed §7▸ 16 Bread §a+5\n§0Dark §7▸ Descend Y≤30 §a+5\n§0Creeper §7▸ 5 Creepers §a+4",
                "buttons": [
                    { "name": "§eWood",    "commands": ["/scriptevent cultista:accept taglialegna"] },
                    { "name": "§eBones",   "commands": ["/scriptevent cultista:accept ossa"] },
                    { "name": "§eFeed",    "commands": ["/scriptevent cultista:accept sfama"] },
                    { "name": "§eDark",    "commands": ["/scriptevent cultista:accept buio"] },
                    { "name": "§eCreeper", "commands": ["/scriptevent cultista:accept creeper"] }
                ]
            },
            {
                "scene_tag": "cultista_hub_en",
                "npc_name": "§5Cultist",
                "text": "§fThe trials are complete.\n§8Now the true Cult rites begin.",
                "buttons": [
                    { "name": "§5» Rites", "commands": ["/dialogue open @e[tag=cultista,r=2] @initiator cultista_riti_en"] }
                ]
            },
            {
                "scene_tag": "cultista_riti_en",
                "npc_name": "§5Cultist",
                "text": "§fThe Cult demands sacrifices.\n\n§5Souls §7▸ Soul Sand x32 + Soul Soil x16 §a+16\n§5Piglin §7▸ 8 Piglin Brutes §a+24\n§5Sacrifice §7▸ Totem x1 + Ghast Tears x4 §a+28\n§cWither §7▸ Kill 1 Wither §a+45",
