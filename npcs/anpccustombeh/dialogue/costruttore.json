{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "costruttore_intro",
                "npc_name": "§9Marco",
                "text": "§aOne moment! I'm sketching something.\n§2Look — this village could be huge.\n§aI just need materials.",
                "on_open_commands": ["/execute as @initiator run scriptevent costruttore:balance"],
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent costruttore:missioni"] },
                    { "name": "§9» Advanced", "commands": ["/scriptevent costruttore:hub_accesso"] },
                    { "name": "§2» The Dream","commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_sogno"] }
                ]
            },
            {
                "scene_tag": "costruttore_sogno",
                "npc_name": "§9Marco",
                "text": "§aA tower in the center. Houses for everyone.\n§2Paved streets, lanterns everywhere.\n§aWithout materials, nothing gets built.",
                "buttons": [
                    { "name": "§eI'll help",      "commands": ["/scriptevent costruttore:missioni"] },
                    { "name": "§eJust a dream...", "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_realista"] }
                ]
            },
            {
                "scene_tag": "costruttore_realista",
                "npc_name": "§9Marco",
                "text": "§a— A dream?\n§2It's a detailed architectural plan.\n§a...Ok, maybe it's a dream. Help me anyway.",
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent costruttore:missioni"] }
                ]
            },
            {
                "scene_tag": "costruttore_main",
                "npc_name": "§9Marco",
                "text": "§aMaterials, materials, materials.\n§2Choose.\n\n§0Coal §7▸ 32 Coal §a+1\n§0Cobble §7▸ 128 Cobblestone §a+1\n§0Oak §7▸ 64 Oak Logs §a+1\n§0Gravel §7▸ 64 Gravel §a+1",
                "buttons": [
                    { "name": "§eCoal", "commands": ["/scriptevent costruttore:accept marco_carbone"] },
                    { "name": "§eCobble",  "commands": ["/scriptevent costruttore:accept marco_ciottoli"] },
                    { "name": "§eOak",     "commands": ["/scriptevent costruttore:accept marco_quercia"] },
                    { "name": "§eGravel",  "commands": ["/scriptevent costruttore:accept marco_ghiaia"] },
                    { "name": "§2« Back",  "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_intro"] }
                ]
            },
            {
                "scene_tag": "costruttore_consegna",
                "npc_name": "§9Marco",
                "text": "§aDo you have the material?\n§2Every block is a brick toward the future.\n\n§0Coal §7▸ 32 Coal\n§0Cobble §7▸ 128 Cobblestone\n§0Oak §7▸ 64 Oak Logs\n§0Gravel §7▸ 64 Gravel",
                "buttons": [
                    { "name": "§eCoal", "commands": ["/scriptevent costruttore:deliver marco_carbone"] },
                    { "name": "§eCobble",  "commands": ["/scriptevent costruttore:deliver marco_ciottoli"] },
                    { "name": "§eOak",     "commands": ["/scriptevent costruttore:deliver marco_quercia"] },
                    { "name": "§eGravel",  "commands": ["/scriptevent costruttore:deliver marco_ghiaia"] },
                    { "name": "§2« Back",  "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_main"] }
                ]
            },
            {
                "scene_tag": "costruttore_hub",
                "npc_name": "§9Marco",
                "text": "§aGreat work so far!\n§2I have bigger plans. Are you ready?",
                "buttons": [
                    { "name": "§9» Projects", "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_sfide"] },
                    { "name": "§a» Deliver",  "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_consegna_av"] }
                ]
            },
            {
                "scene_tag": "costruttore_sfide",
                "npc_name": "§9Marco",
                "text": "§aPrecious materials for big projects.\n§2Choose a project.\n\n§0Iron+Gold §7▸ Iron x128 + Gold x64 §a+1\n§0Obsidian §7▸ Obsidian x64 + Crying x16 §a+1\n§0Nether §7▸ Nether Bricks x64 + Quartz x32 §a+1\n§6Netherite §7▸ 8 Netherite Ingots §a+1",
                "buttons": [
                    { "name": "§eIron+Gold", "commands": ["/scriptevent costruttore:accept marco_ferro_oro"] },
                    { "name": "§eObsidian",  "commands": ["/scriptevent costruttore:accept marco_ossidiana"] },
                    { "name": "§eNether",    "commands": ["/scriptevent costruttore:accept marco_nether"] },
                    { "name": "§6Netherite", "commands": ["/scriptevent costruttore:accept marco_netherite"] },
                    { "name": "§2« Back",    "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_hub"] }
                ]
            },
            {
                "scene_tag": "costruttore_consegna_av",
                "npc_name": "§9Marco",
                "text": "§aDo you have the materials?\n§2Every block counts.\n\n§0Coal §7▸ 32 Coal\n§0Iron+Gold §7▸ Iron x128 + Gold x64\n§0Obsidian §7▸ Obsidian x64 + Crying x16\n§0Nether §7▸ Bricks x64 + Quartz x32\n§6Netherite §7▸ 8 Netherite",
                "buttons": [
                    { "name": "§eCoal",  "commands": ["/scriptevent costruttore:deliver marco_carbone"] },
                    { "name": "§eIron+Gold","commands": ["/scriptevent costruttore:deliver marco_ferro_oro"] },
                    { "name": "§eObsidian", "commands": ["/scriptevent costruttore:deliver marco_ossidiana"] },
                    { "name": "§eNether",   "commands": ["/scriptevent costruttore:deliver marco_nether"] },
                    { "name": "§6Netherite","commands": ["/scriptevent costruttore:deliver marco_netherite"] },
                    { "name": "§2« Back",   "commands": ["/dialogue open @e[tag=costruttore,r=2] @initiator costruttore_hub"] }
                ]
            }
        ]
    }
}
