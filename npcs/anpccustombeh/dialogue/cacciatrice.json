{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "cacciatrice_intro",
                "npc_name": "§6Elena",
                "text": "§eI've been watching you.\n§6Most adventurers pretend.\n§eYou seem different. Maybe.",
                "on_open_commands": ["/execute as @initiator run scriptevent cacciatrice:balance"],
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent cacciatrice:missioni"] },
                    { "name": "§c» Advanced", "commands": ["/scriptevent cacciatrice:hub_accesso"] },
                    { "name": "§6» Challenge","commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_sfida"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_sfida",
                "npc_name": "§6Elena",
                "text": "§e— Interesting.\n§6Those who talk like that run from the first creeper.\n§eProve it. Choose your prey.",
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent cacciatrice:missioni"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_main",
                "npc_name": "§6Elena",
                "text": "§eChoose your prey. Come back with proof.\n§6No excuses.\n\n§0Zombies §7▸ 20 Zombies §a+1\n§0Skeletons §7▸ 25 Skeletons §a+1\n§0Cows §7▸ 15 Cows §a+1\n§0Chickens §7▸ 15 Chickens §a+1",
                "buttons": [
                    { "name": "§eZombies",     "commands": ["/scriptevent cacciatrice:accept elena_zombie"] },
                    { "name": "§eSkeletons",   "commands": ["/scriptevent cacciatrice:accept elena_scheletri"] },
                    { "name": "§eCows",        "commands": ["/scriptevent cacciatrice:accept elena_vacche"] },
                    { "name": "§eChickens", "commands": ["/scriptevent cacciatrice:accept elena_polli"] },
                    { "name": "§6« Back",      "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_intro"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_consegna",
                "npc_name": "§6Elena",
                "text": "§eHunt well?\n§6Tell me what you got.\n\n§0Zombies §7▸ 20 Zombies killed\n§0Skeletons §7▸ 25 Skeletons killed\n§0Cows §7▸ 15 Cows killed\n§0Chickens §7▸ 15 Chickens killed",
                "buttons": [
                    { "name": "§eZombies",     "commands": ["/scriptevent cacciatrice:deliver elena_zombie"] },
                    { "name": "§eSkeletons",   "commands": ["/scriptevent cacciatrice:deliver elena_scheletri"] },
                    { "name": "§eCows",        "commands": ["/scriptevent cacciatrice:deliver elena_vacche"] },
                    { "name": "§eChickens", "commands": ["/scriptevent cacciatrice:deliver elena_polli"] },
                    { "name": "§6« Back",      "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_main"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_hub",
                "npc_name": "§6Elena",
                "text": "§eYou proved you can hunt.\n§6Now let's see with real prey.",
                "buttons": [
                    { "name": "§c» Challenges", "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_sfide"] },
                    { "name": "§a» Deliver",    "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_consegna_av"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_sfide",
                "npc_name": "§6Elena",
                "text": "§eChoose your prey. Don't come back empty handed.\n\n§0Blaze §7▸ 25 Blaze §a+1\n§0Wither Sk. §7▸ 20 Wither Skeletons §a+1\n§0Phantom §7▸ 15 Phantoms + 8 Membranes §a+1\n§cWither §7▸ 1 Wither §a+1",
                "buttons": [
                    { "name": "§eBlaze",      "commands": ["/scriptevent cacciatrice:accept elena_blaze"] },
                    { "name": "§eWither Sk.", "commands": ["/scriptevent cacciatrice:accept elena_wither_sk"] },
                    { "name": "§ePhantom",    "commands": ["/scriptevent cacciatrice:accept elena_phantom"] },
                    { "name": "§cWither",     "commands": ["/scriptevent cacciatrice:accept elena_wither"] },
                    { "name": "§6« Back",     "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_hub"] }
                ]
            },
            {
                "scene_tag": "cacciatrice_consegna_av",
                "npc_name": "§6Elena",
                "text": "§eBring me proof.\n§6No excuses.\n\n§0Chickens §7▸ 15 Chickens\n§0Blaze §7▸ 25 Blaze\n§0Wither Sk. §7▸ 20 Wither Skeletons\n§0Phantom §7▸ 15 Phantoms + 8 Membranes\n§cWither §7▸ 1 Wither",
                "buttons": [
                    { "name": "§eChickens", "commands": ["/scriptevent cacciatrice:deliver elena_polli"] },
                    { "name": "§eBlaze",       "commands": ["/scriptevent cacciatrice:deliver elena_blaze"] },
                    { "name": "§eWither Sk.",  "commands": ["/scriptevent cacciatrice:deliver elena_wither_sk"] },
                    { "name": "§ePhantom",     "commands": ["/scriptevent cacciatrice:deliver elena_phantom"] },
                    { "name": "§cWither",      "commands": ["/scriptevent cacciatrice:deliver elena_wither"] },
                    { "name": "§6« Back",      "commands": ["/dialogue open @e[tag=cacciatrice,r=2] @initiator cacciatrice_hub"] }
                ]
            }
        ]
    }
}
