{
    "format_version": "1.17",
    "minecraft:npc_dialogue": {
        "scenes": [
            {
                "scene_tag": "decoratrice_intro",
                "npc_name": "§dSofia",
                "text": "§dLook at this place. Empty. Dull.\n§5I have a thousand ideas but no materials.\n§dWhat are you doing here?",
                "on_open_commands": ["/execute as @initiator run scriptevent decoratrice:balance"],
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/scriptevent decoratrice:missioni"] },
                    { "name": "§d» Advanced", "commands": ["/scriptevent decoratrice:hub_accesso"] },
                    { "name": "§5» The Plan", "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_piano"] }
                ]
            },
            {
                "scene_tag": "decoratrice_piano",
                "npc_name": "§dSofia",
                "text": "§dFlowers everywhere! Colored wool for carpets.\n§5Vivid colors, bamboo in the corner...\n§dIt would be beautiful. Help me?",
                "buttons": [
                    { "name": "§e» Missions", "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_main"] }
                ]
            },
            {
                "scene_tag": "decoratrice_main",
                "npc_name": "§dSofia",
                "text": "§dBring me something beautiful!\n§5Choose.\n\n§0Flowers §7▸ 32 Flowers §a+1\n§0Wool §7▸ 24 Wool (any) §a+1\n§0Dye §7▸ 16 Dye §a+1\n§0Bamboo §7▸ 32 Bamboo §a+1",
                "buttons": [
                    { "name": "§eFlowers", "commands": ["/scriptevent decoratrice:accept sofia_fiori"] },
                    { "name": "§eWool",       "commands": ["/scriptevent decoratrice:accept sofia_lana"] },
                    { "name": "§eDye",        "commands": ["/scriptevent decoratrice:accept sofia_colorante"] },
                    { "name": "§eBamboo",  "commands": ["/scriptevent decoratrice:accept sofia_bamboo"] },
                    { "name": "§5« Back",     "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_intro"] }
                ]
            },
            {
                "scene_tag": "decoratrice_consegna",
                "npc_name": "§dSofia",
                "text": "§dFound something beautiful?\n§5Show me!\n\n§0Flowers §7▸ 32 Flowers\n§0Wool §7▸ 24 Wool\n§0Dye §7▸ 16 Dye\n§0Bamboo §7▸ 32 Bamboo",
                "buttons": [
                    { "name": "§eFlowers", "commands": ["/scriptevent decoratrice:deliver sofia_fiori"] },
                    { "name": "§eWool",       "commands": ["/scriptevent decoratrice:deliver sofia_lana"] },
                    { "name": "§eDye",        "commands": ["/scriptevent decoratrice:deliver sofia_colorante"] },
                    { "name": "§eBamboo",  "commands": ["/scriptevent decoratrice:deliver sofia_bamboo"] },
                    { "name": "§5« Back",     "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_main"] }
                ]
            },
            {
                "scene_tag": "decoratrice_hub",
                "npc_name": "§dSofia",
                "text": "§dI have even bigger ideas!\n§5But I need special materials...",
                "buttons": [
                    { "name": "§d» Projects", "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_sfide"] },
                    { "name": "§a» Deliver",  "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_consegna_av"] }
                ]
            },
            {
                "scene_tag": "decoratrice_sfide",
                "npc_name": "§dSofia",
                "text": "§dChoose what to bring me!\n§5It will be beautiful, I promise.\n\n§0Glass §7▸ Stained Glass x64 + Glowstone x32 §a+1\n§0Sculk §7▸ Sculk x32 + Sensor x8 §a+1\n§0Prismarine §7▸ Pris.Bricks x64 + Sea Lanterns x32 §a+1\n§0Candles §7▸ Candles x32 + Honeycomb x16 + Amethyst x32 §a+1",
                "buttons": [
                    { "name": "§eGlass",      "commands": ["/scriptevent decoratrice:accept sofia_vetro_glow"] },
                    { "name": "§eSculk",      "commands": ["/scriptevent decoratrice:accept sofia_sculk"] },
                    { "name": "§ePrismarine", "commands": ["/scriptevent decoratrice:accept sofia_prisma"] },
                    { "name": "§eCandles",    "commands": ["/scriptevent decoratrice:accept sofia_candele_miele"] },
                    { "name": "§5« Back",     "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_hub"] }
                ]
            },
            {
                "scene_tag": "decoratrice_consegna_av",
                "npc_name": "§dSofia",
                "text": "§dFound something special?\n§5Show me, show me!\n\n§0Flowers §7▸ 32 Flowers\n§0Glass §7▸ Stained Glass x64 + Glowstone x32\n§0Sculk §7▸ Sculk x32 + Sensor x8\n§0Prismarine §7▸ Pris.Bricks x64 + Sea Lanterns x32\n§0Candles §7▸ Candles x32 + Honeycomb x16 + Amethyst x32",
                "buttons": [
                    { "name": "§eFlowers", "commands": ["/scriptevent decoratrice:deliver sofia_fiori"] },
                    { "name": "§eGlass",      "commands": ["/scriptevent decoratrice:deliver sofia_vetro_glow"] },
                    { "name": "§eSculk",      "commands": ["/scriptevent decoratrice:deliver sofia_sculk"] },
                    { "name": "§ePrismarine", "commands": ["/scriptevent decoratrice:deliver sofia_prisma"] },
                    { "name": "§eCandles",    "commands": ["/scriptevent decoratrice:deliver sofia_candele_miele"] },
                    { "name": "§5« Back",     "commands": ["/dialogue open @e[tag=decoratrice,r=2] @initiator decoratrice_hub"] }
                ]
            }
        ]
    }
}
